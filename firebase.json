{
  "functions": {
    "source": "artifacts/api-server",
    "codebase": "pastora-api",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --filter @workspace/api-server run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}

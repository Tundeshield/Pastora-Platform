{
  "functions": {
    "source": "artifacts/api-server",
    "codebase": "pastora-api",
    "runtime": "nodejs22",
    "predeploy": [
      "pnpm --filter @workspace/api-server run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

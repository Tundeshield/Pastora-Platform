# Firebase web configuration — public identifiers, safe to ship to browsers.
# Locally: copy to artifacts/pastora/.env.local. On Netlify: set with scope "Builds".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only credentials for the API (never prefix with VITE_, never commit values).
# Either the whole service-account JSON (local/Replit):
# FIREBASE_SERVICE_ACCOUNT_JSON=
# or the three fields (Netlify Functions, scope "Functions", private key marked secret):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
